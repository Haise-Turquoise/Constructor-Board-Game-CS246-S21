CXX = g++
CXXFLAGS = -std=c++14 -Werror=vla -g -Wall -MMD
OBJECTS = main.o board.o player.o edge.o vertex.o tile.o subject.o
DEPENDS = ${OBJECTS:.o=.d}
EXEC = ctor

${EXEC} : ${OBJECTS}
	${CXX} ${CXXFLAGS} ${OBJECTS} -o ${EXEC}

board.o: board-untest.cc board.h player.h vertex.h edge.h subject.h observer.h
player.o: player-untest.cc player.h vertex.h edge.h subject.h observer.h
edge.o: edge-untest.cc edge.h vertex.h
subject.o: subject-untest.cc subject.h observer.h
tile.o: tile-untest.cc tile.h subject.h observer.h
vertex.o: vertex-untest.cc vertex.h observer.h
main.o: main.cc board.h player.h vertex.h edge.h subject.h observer.h

.PHONY: clean

clean :
	rm ${DEPENDS} ${OBJECTS} ${EXEC}

-include ${DEPENDS} # reads the .d files and reruns dependencies
